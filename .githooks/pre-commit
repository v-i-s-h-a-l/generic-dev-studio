#!/usr/bin/env bash
# Pre-commit hook for generic-dev-studio. Seven gates in order:
#   1.  update-surface-manifest.sh — regenerate + auto-stage docs-surface.json.
#   1b. capability-manifest.sh --regen — regenerate + auto-stage the manifest.
#   2.  lint-architecture.sh --staged — router/frontmatter/dup/surface checks.
#   2b. lint-skill-prose.sh --staged — Authoring Standard gate (REVIEW.md R18).
#   2c. lint-build-invocations.sh --staged — block raw xcodebuild / swift
#       calls outside the gate scripts (#216).
#   2d. lint-comms-boundary.sh --staged — agent-comms-boundary contract gate
#       (#247): writer ownership + lifecycle co-writer enumeration.
#   2e. lint-mode-pack.sh --staged — mode-pack discipline (MP1–MP4, #227):
#       budget_tokens enforcement, _shared/* dup detection, router cap.
#   3.  privacy gate — reject if staged diff leaks another project's runtime.
#
# Emergency bypass: `ARCH_LINT=0 git commit ...` skips gates 2/2b/2c/2d/2e/3.
# Gates 1+1b (manifest regens) always run because stale manifests leak
# downstream.

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
SCRIPTS="$REPO_ROOT/scripts"

# Gate 1 — regenerate manifest + restage if it changed.
if [ -x "$SCRIPTS/update-surface-manifest.sh" ]; then
  "$SCRIPTS/update-surface-manifest.sh" >/dev/null || {
    printf 'pre-commit: update-surface-manifest.sh failed\n' >&2
    exit 1
  }
  if ! git diff --quiet -- "$REPO_ROOT/docs-surface.json" 2>/dev/null; then
    git add "$REPO_ROOT/docs-surface.json" 2>/dev/null || true
  fi
fi

# Gate 1b — regenerate capability manifest + restage on drift. Mirrors 1.
if [ -x "$SCRIPTS/capability-manifest.sh" ]; then
  "$SCRIPTS/capability-manifest.sh" --regen >/dev/null || {
    printf 'pre-commit: capability-manifest.sh --regen failed\n' >&2
    exit 1
  }
  if ! git diff --quiet -- "$REPO_ROOT/_shared/schemas/capability-manifest.json" 2>/dev/null; then
    git add "$REPO_ROOT/_shared/schemas/capability-manifest.json" 2>/dev/null || true
  fi
fi

if [ "${ARCH_LINT:-1}" = "0" ]; then
  printf 'pre-commit: ARCH_LINT=0 — skipping architecture + privacy gates (emergency bypass)\n' >&2
  exit 0
fi

# Gate 2 — architecture linter.
if [ -x "$SCRIPTS/lint-architecture.sh" ]; then
  "$SCRIPTS/lint-architecture.sh" --staged
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '\npre-commit: architecture violations above — see _shared/rules/enforcement-contract.md\n' >&2
    printf 'bypass (emergencies only): ARCH_LINT=0 git commit ...\n' >&2
    exit 1
  fi
fi

# Gate 2b — Skill Authoring Standard linter (REVIEW.md R18).
if [ -x "$SCRIPTS/lint-skill-prose.sh" ]; then
  "$SCRIPTS/lint-skill-prose.sh" --staged
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '\npre-commit: skill-prose violations above — see _shared/standards/skill-authoring.md\n' >&2
    printf 'bypass (emergencies only): ARCH_LINT=0 git commit ...\n' >&2
    exit 1
  fi
fi

# Gate 2c — raw build-toolchain invocation linter (#216).
if [ -x "$SCRIPTS/lint-build-invocations.sh" ]; then
  "$SCRIPTS/lint-build-invocations.sh" --staged
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '\npre-commit: raw xcodebuild / swift invocation found outside the gate scripts — see _shared/primitives/build-gate.md\n' >&2
    printf 'bypass (emergencies only): ARCH_LINT=0 git commit ...\n' >&2
    exit 1
  fi
fi

# Gate 2d — comms-boundary linter (#247).
if [ -x "$SCRIPTS/lint-comms-boundary.sh" ]; then
  "$SCRIPTS/lint-comms-boundary.sh" --staged
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '\npre-commit: comms-boundary violations above — see _shared/primitives/agent-comms-boundary.md\n' >&2
    printf 'bypass (emergencies only): ARCH_LINT=0 git commit ...\n' >&2
    exit 1
  fi
fi

# Gate 2e — mode-pack discipline linter (#227).
if [ -x "$SCRIPTS/lint-mode-pack.sh" ]; then
  "$SCRIPTS/lint-mode-pack.sh" --staged
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '\npre-commit: mode-pack violations above — see _shared/rules/mode-pack-discipline.md\n' >&2
    printf 'bypass (emergencies only): ARCH_LINT=0 git commit ...\n' >&2
    exit 1
  fi
fi

# Gate 3 — privacy.
#
# Reject commits whose staged diff references another project's runtime path.
# `~/.dev-studio/<other-project>/` leakage into a public repo is a CLAUDE.md
# privacy violation. Current project (resolved from git toplevel) is exempt;
# so is `.runtime/` which is machine-global.
. "$SCRIPTS/lib-paths.sh" 2>/dev/null || true
CURRENT=$(basename "$REPO_ROOT")
HOME_DS="$HOME/.dev-studio"

# The set of known project slugs under ~/.dev-studio that aren't the current
# one. If the dir doesn't exist, nothing to compare against.
leaks=""
if [ -d "$HOME_DS" ]; then
  # Build a list of other-project slugs. `.runtime` is machine-global, not a
  # project, and is permitted.
  # Use an if-chain instead of a case arm: bash 3.2 (macOS default) has a
  # parser bug where `case` inside `while read` inside a pipe inside `$(...)`
  # rejects empty arms. if-chain sidesteps it.
  others=$(find "$HOME_DS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
    | while IFS= read -r d; do
        slug=$(basename "$d")
        if [ "$slug" != ".runtime" ] && [ "$slug" != "$CURRENT" ]; then
          printf '%s\n' "$slug"
        fi
      done)
  if [ -n "$others" ]; then
    # Inspect only added lines. Removals that clean up a pre-existing leak are
    # a good thing; treating them as violations blocks legitimate cleanup.
    # `^+` matches added content; `^+++` matches the file-path header and is
    # excluded via the second grep.
    added_blob=$(git diff --cached --unified=0 2>/dev/null | grep '^+' | grep -v '^+++')
    while IFS= read -r slug; do
      [ -z "$slug" ] && continue
      # Match paths like `.dev-studio/<slug>/` or `~/.dev-studio/<slug>/`.
      if printf '%s' "$added_blob" | grep -qE "\\.dev-studio/${slug}(/|\$|[\"' ])"; then
        leaks="${leaks:+$leaks }${slug}"
      fi
    done <<< "$others"
  fi
fi

if [ -n "$leaks" ]; then
  printf 'E_PRIVACY_LEAK:staged diff references other-project runtime: %s | strip other-project paths or abstract to <project> placeholder\n' "$leaks" >&2
  printf 'bypass (emergencies only): ARCH_LINT=0 git commit ...\n' >&2
  exit 1
fi

exit 0
