      "description": "Storage, budget, ownership, and lazy-load declaration."
    },
    {
      "path": "context.md",
      "kind": "context",
      "load_policy": "initial",
      "required": true,
      "max_bytes": 4096,
      "estimated_tokens": 360,
      "schema_ref": null,
      "description": "Compact resume context with lazy-load hints."
    },
    {
      "path": "state.json",
      "kind": "state",
      "load_policy": "lazy",
      "required": true,
      "max_bytes": 4096,
      "estimated_tokens": 450,
      "schema_ref": "core/v2/schemas/checkpoint-state.schema.json",
      "description": "Role-owned structured state."
    },
    {
      "path": "next-steps.json",
      "kind": "next-steps",
      "load_policy": "lazy",
      "required": true,
      "max_bytes": 4096,
      "estimated_tokens": 300,
