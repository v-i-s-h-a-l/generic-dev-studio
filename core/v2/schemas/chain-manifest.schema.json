{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chain-manifest.schema.json",
  "title": "Studio chain runner manifest",
  "description": "Manifest schema for scripts/studio-chain-runner.sh, including optional selective rule-pack declarations.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "chains"],
  "properties": {
    "schema_version": { "const": 1 },
    "target_repo_root": { "type": "string", "minLength": 1 },
    "repo_root": { "type": "string", "minLength": 1 },
    "issue_repo": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "repo": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "issue_repo": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "issue": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "name_with_owner": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        }
      }
    },
    "rule_packs": { "$ref": "#/$defs/rule_packs" },
    "execution_policy": { "$ref": "#/$defs/execution_policy" },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chain" }
    }
  },
  "$defs": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_list": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pack_id" },
      "default": []
    },
    "rule_packs": {
      "oneOf": [
        { "$ref": "#/$defs/pack_list" },
        { "$ref": "#/$defs/pack_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "$ref": "#/$defs/pack_list" },
            "optional": { "$ref": "#/$defs/pack_list" },
            "advisory": { "$ref": "#/$defs/pack_list" },
            "disabled": { "$ref": "#/$defs/pack_list" },
            "exclude": { "$ref": "#/$defs/pack_list" },
            "excluded": { "$ref": "#/$defs/pack_list" }
          },
          "default": {
            "required": [],
            "optional": [],
            "advisory": [],
            "disabled": []
          }
        }
      ]
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "build_test_affinity": {
          "enum": ["chain", "none"],
          "default": "chain"
        },
        "derived_data_scope": {
          "enum": ["chain-lane", "issue"],
          "default": "chain-lane"
        },
        "prefer_local_manager": {
          "type": "boolean",
          "default": true
        },
        "max_affinity_queue_wait_sec": {
          "type": "integer",
          "minimum": 0,
          "default": 900
        },
        "artifact_retention": {
          "enum": ["default", "success-prune", "failure-retain", "release-retain"],
          "default": "default"
        },
        "offload_economics": {
          "enum": ["required", "advisory", "disabled"],
          "default": "required"
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "issues"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "default": "main" },
        "branch": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "default": "auto" },
        "approved_release_id": { "type": "string", "minLength": 1 },
        "sync_strategy": { "enum": ["rebase", "squash"], "default": "rebase" },
        "phase_review": { "enum": ["required", "auto", "off"], "default": "auto" },
        "execution_policy": { "$ref": "#/$defs/execution_policy" },
        "rule_packs": { "$ref": "#/$defs/rule_packs" },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              {
                "type": "object",
                "additionalProperties": true,
                "anyOf": [
                  { "required": ["number"] },
                  { "required": ["issue"] }
                ],
                "properties": {
                  "number": { "type": "integer", "minimum": 1 },
                  "issue": { "type": "integer", "minimum": 1 },
                  "dependencies": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 },
                    "default": []
                  },
                  "depends_on": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 },
                    "default": []
                  },
                  "rule_packs": { "$ref": "#/$defs/rule_packs" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
