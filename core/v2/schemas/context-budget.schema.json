{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio v2 context-budget manifest",
  "description": "Unified context-budget policy for role, skill, and invocation dimensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "defaults",
    "resolution",
    "roles",
    "skills",
    "invocations",
    "telemetry"
  ],
  "properties": {
    "schema_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "min_reader", "deprecated_at"],
      "properties": {
        "name": {"const": "context-budget"},
        "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
        "min_reader": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
        "deprecated_at": {"type": ["string", "null"]}
      }
    },
    "kind": {"const": "studio-v2-context-budget"},
    "description": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_context_tokens", "warning_ratio", "exceeded_ratio"],
      "properties": {
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "warning_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "exceeded_ratio": {"type": "number", "minimum": 1},
        "default_mode_budget": {"type": "integer", "minimum": 1}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "dimensions",
        "unknown_skill_policy",
        "unknown_invocation_policy",
        "unknown_role_policy"
      ],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "array",
          "items": {"enum": ["role", "skill", "invocation"]},
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "unknown_skill_policy": {"enum": ["use-default", "reject"]},
        "unknown_invocation_policy": {"enum": ["use-default", "reject"]},
        "unknown_role_policy": {"enum": ["reject"]}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/roleBudget"}
    },
    "skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skillBudget"}
    },
    "invocations": {
      "type": "array",
      "items": {"$ref": "#/$defs/invocationBudget"}
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_event", "exceeded_event", "required_fields"],
      "properties": {
        "resolved_event": {"type": "string", "minLength": 1},
        "exceeded_event": {"type": "string", "minLength": 1},
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "roleBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "max_context_tokens", "required_declared_reads", "telemetry_scope"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "required_declared_reads": {"type": "boolean"},
        "telemetry_scope": {"const": "role"}
      }
    },
    "skillBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "source", "max_context_tokens", "load_policy"],
      "properties": {
        "skill": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source": {"type": "string", "minLength": 1},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "load_policy": {"enum": ["on-demand", "always", "never"]}
      }
    },
    "invocationBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "max_context_tokens", "telemetry_event"],
      "properties": {
        "invocation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "telemetry_event": {"type": "string", "minLength": 1}
      }
    }
  }
}
