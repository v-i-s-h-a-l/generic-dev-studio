{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generic-dev-studio.local/core/v2/schemas/subscriber-checkpoint.schema.json",
  "title": "Studio v2 subscriber checkpoint",
  "type": "object",
  "required": ["schema_version", "subscriber", "shard", "next_byte_offset", "updated_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subscriber": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "shard": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.jsonl$" },
    "next_byte_offset": { "type": "integer", "minimum": 0 },
    "last_event_id": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
