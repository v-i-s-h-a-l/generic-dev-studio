{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debrief.schema.json",
  "schema": 1,
  "title": "Debrief",
  "description": "YAML shape Achilles emits after task / direct-debrief completion. Formalizes schemas/debrief.md. Composes worker-report.schema.json for report_state semantics. Validation is against the YAML parsed to JSON by the validator wrapper (check-jsonschema supports --format=yaml).",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "task_id",
    "brief_id",
    "mode",
    "state",
    "completed_at",
    "branch",
    "commits",
    "diff_summary",
    "decisions",
    "tests",
    "testability",
    "build_gate",
    "build_debt_override",
    "debt",
    "performance",
    "key_learnings",
    "known_issues",
    "follow_ups",
    "open_questions",
    "argus_review"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "#/$defs/uuidv7"
    },
    "task_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuidv7"
        },
        {
          "type": "null"
        }
      ]
    },
    "brief_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuidv7"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "task",
        "direct-debrief"
      ]
    },
    "state": {
      "enum": [
        "emitted",
        "ingested",
        "superseded"
      ]
    },
    "completed_at": {
      "$ref": "#/$defs/rfc3339"
    },
    "branch": {
      "type": "object",
      "required": [
        "worked_on",
        "merged_into",
        "merge_sha"
      ],
      "properties": {
        "worked_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged_into": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sha",
          "message"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "minLength": 7
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "diff_summary": {
      "type": "object",
      "required": [
        "files",
        "added_lines",
        "removed_lines"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "added_lines": {
          "type": "integer",
          "minimum": 0
        },
        "removed_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "added",
        "modified",
        "skipped_because"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        },
        "skipped_because": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "testability": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "solid_adherence": {
              "type": "string"
            },
            "accessibility_ids": {
              "type": "string"
            },
            "test_seams": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "architecture": {
              "type": "string"
            },
            "localization": {
              "type": "string"
            }
          }
        }
      ]
    },
    "build_gate": {
      "enum": [
        "lsp-only",
        "full-green"
      ]
    },
    "build_debt_override": {
      "type": "boolean"
    },
    "debt": {
      "type": "object",
      "required": [
        "build",
        "test_unit",
        "test_ui"
      ],
      "properties": {
        "build": {
          "type": "boolean"
        },
        "test_unit": {
          "type": "boolean"
        },
        "test_ui": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "device": {
            "type": "string"
          }
        }
      }
    },
    "key_learnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/concern" }
    },
    "follow_ups": {
      "type": "array",
      "items": { "$ref": "#/$defs/concern" }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argus_review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "flagged",
            "blocked",
            "skipped",
            "not-invoked"
          ]
        },
        "review_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuidv7"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "report_state": {
      "$ref": "worker-report.schema.json#/$defs/reportState"
    },
    "review_loop": {
      "$ref": "worker-report.schema.json#/$defs/reviewLoop"
    },
    "review_responses": {
      "type": "array",
      "items": {
        "$ref": "worker-report.schema.json#/$defs/reviewResponse"
      }
    }
  },
  "allOf": [
    {
      "description": "task mode: task_id and brief_id required non-null.",
      "if": {
        "properties": {
          "mode": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "$ref": "#/$defs/uuidv7"
          },
          "brief_id": {
            "$ref": "#/$defs/uuidv7"
          }
        }
      }
    },
    {
      "description": "direct-debrief mode: task_id and brief_id must both be null.",
      "if": {
        "properties": {
          "mode": {
            "const": "direct-debrief"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "brief_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "When report_state is present, apply the worker-report per-state required-field matrix.",
      "if": {
        "required": [
          "report_state"
        ]
      },
      "then": {
        "$ref": "worker-report.schema.json#/$defs/perStateRequirements"
      }
    }
  ],
  "$defs": {
    "concern": {
      "description": "Debrief concern entry (known_issues / follow_ups). String form is legacy (pre-2.3.0); object form carries a stable id readers/validators can trace into successor briefs (#162). Synthesize an id for legacy strings as `<task-or-debrief-id>-<ki|fu>-<index>` at read time.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["id", "text"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
            "text": { "type": "string" },
            "category": { "type": "string" },
            "severity": { "enum": ["low", "medium", "high", "critical"] }
          }
        }
      ]
    },
    "testCase": {
      "description": "Debrief test-case entry. String form is legacy/title-only; object form is canonical for new task-mode emits so test manifests can be regenerated from YAML without sidecar markdown.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string" },
            "preconditions": { "type": "string" },
            "steps": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": { "type": "string" }
                }
              ]
            },
            "expected": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "schemaVersion": {
      "description": "Legacy object form per contracts/schema-version.md. EVOLUTION.md names `schema: <int>` as the preferred form going forward; both are accepted during the FULL_TRANSITIVE transition window.",
      "type": "object",
      "required": [
        "name",
        "version",
        "min_reader"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "min_reader": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "deprecated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": {
        "name": "debrief",
        "version": "2.0.2",
        "min_reader": "2.0.0",
        "deprecated_at": null
      },
      "id": "0190f52a-79aa-7d02-8b88-33ce5fe65e66",
      "task_id": "0190f52a-6e0c-7b3c-9a1d-0d4e9b7f6a11",
      "brief_id": "0190f52a-6e11-7c01-8a77-11a05a9e2b4c",
      "mode": "task",
      "state": "emitted",
      "completed_at": "2026-04-22T12:40:51Z",
      "branch": {
        "worked_on": "achilles/T001",
        "merged_into": "feature/filter-presets",
        "merge_sha": "a1b2c3d4e5f60718293a4b5c6d7e8f90"
      },
      "commits": [
        {
          "sha": "a1b2c3d4e5f6",
          "message": "Add FilterPresetRow"
        }
      ],
      "diff_summary": {
        "files": 4,
        "added_lines": 187,
        "removed_lines": 12
      },
      "decisions": [],
      "tests": {
        "added": [],
        "modified": [],
        "skipped_because": null
      },
      "testability": null,
      "build_gate": "lsp-only",
      "build_debt_override": false,
      "debt": {
        "build": false,
        "test_unit": false,
        "test_ui": false,
        "notes": null
      },
      "performance": [],
      "key_learnings": [],
      "known_issues": [],
      "follow_ups": [],
      "open_questions": [],
      "argus_review": {
        "status": "approved",
        "review_id": "0190f52a-7a11-7e03-8c99-44df6fd77a77",
        "notes": null
      },
      "report_state": "done"
    }
  ]
}
