{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-report.schema.json",
  "schema": 1,
  "title": "Worker Report",
  "description": "Four-state enum every worker emits on task completion, plus the required-field matrix per state. Formalizes contracts/worker-report.md. Consumed as a slice of the debrief artifact \u2014 debrief.schema.json $refs $defs from this file.",
  "type": "object",
  "required": [
    "report_state"
  ],
  "properties": {
    "report_state": {
      "$ref": "#/$defs/reportState"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/perStateRequirements"
    }
  ],
  "$defs": {
    "reportState": {
      "type": "string",
      "enum": [
        "done",
        "done_with_concerns",
        "blocked",
        "needs_context"
      ],
      "description": "done = all green, close normally. done_with_concerns = merged with caveats the user should see. blocked = no merge, needs user input. needs_context = brief incomplete, regenerate."
    },
    "perStateRequirements": {
      "description": "Per-state required-field matrix from contracts/worker-report.md \u00a7Required-field matrix. Each branch constrains the payload slice that must be present when report_state has the given value. These are checked as-if on the debrief payload this slice lives in, so downstream validators composing this schema must have visibility to branch.merge_sha, debt, argus_review, tests, known_issues, open_questions, brief_id.",
      "oneOf": [
        {
          "properties": {
            "report_state": {
              "const": "done"
            },
            "branch": {
              "type": "object",
              "required": [
                "merge_sha"
              ],
              "properties": {
                "merge_sha": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "argus_review": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "approved",
                    "skipped",
                    "not-invoked"
                  ]
                }
              }
            },
            "debt": {
              "type": "object",
              "properties": {
                "build": {
                  "const": false
                },
                "test_unit": {
                  "const": false
                },
                "test_ui": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "properties": {
            "report_state": {
              "const": "done_with_concerns"
            },
            "branch": {
              "type": "object",
              "required": [
                "merge_sha"
              ],
              "properties": {
                "merge_sha": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "anyOf": [
            {
              "properties": {
                "debt": {
                  "type": "object",
                  "properties": {
                    "build": {
                      "const": true
                    }
                  },
                  "required": [
                    "build"
                  ]
                }
              }
            },
            {
              "properties": {
                "debt": {
                  "type": "object",
                  "properties": {
                    "test_unit": {
                      "const": true
                    }
                  },
                  "required": [
                    "test_unit"
                  ]
                }
              }
            },
            {
              "properties": {
                "debt": {
                  "type": "object",
                  "properties": {
                    "test_ui": {
                      "const": true
                    }
                  },
                  "required": [
                    "test_ui"
                  ]
                }
              }
            },
            {
              "properties": {
                "tests": {
                  "type": "object",
                  "properties": {
                    "skipped_because": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "skipped_because"
                  ]
                }
              }
            },
            {
              "properties": {
                "known_issues": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          ]
        },
        {
          "properties": {
            "report_state": {
              "const": "blocked"
            },
            "branch": {
              "type": "object",
              "properties": {
                "merge_sha": {
                  "type": "null"
                }
              },
              "required": [
                "merge_sha"
              ]
            },
            "known_issues": {
              "type": "array",
              "minItems": 1
            },
            "argus_review": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "not": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "report_state": {
              "const": "needs_context"
            },
            "branch": {
              "type": "object",
              "properties": {
                "merge_sha": {
                  "type": "null"
                }
              },
              "required": [
                "merge_sha"
              ]
            },
            "open_questions": {
              "type": "array",
              "minItems": 1
            },
            "brief_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "report_state": "done",
      "branch": {
        "merge_sha": "a1b2c3d4e5f60718293a4b5c6d7e8f90"
      },
      "argus_review": {
        "status": "approved"
      },
      "debt": {
        "build": false,
        "test_unit": false,
        "test_ui": false
      }
    },
    {
      "report_state": "done_with_concerns",
      "branch": {
        "merge_sha": "a1b2c3d4e5f60718293a4b5c6d7e8f90"
      },
      "debt": {
        "build": true,
        "test_unit": false,
        "test_ui": false
      }
    },
    {
      "report_state": "blocked",
      "branch": {
        "merge_sha": null
      },
      "known_issues": [
        "Figma spec for empty state is missing; Argus flagged."
      ],
      "argus_review": {
        "status": "flagged"
      }
    },
    {
      "report_state": "needs_context",
      "branch": {
        "merge_sha": null
      },
      "open_questions": [
        "Which accessibility identifier namespace applies to Filter presets?"
      ],
      "brief_id": "0190f52a-6e11-7c01-8a77-11a05a9e2b4c"
    }
  ]
}
