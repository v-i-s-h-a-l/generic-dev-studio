# Copy to ~/.dev-studio/<project>/config/release.env.
# Keep real tokens and private keys under ~/.dev-studio/<project>/secrets/.

STUDIO_TF_PROJECT_ROOT="/absolute/path/to/project-checkout"
STUDIO_TF_PROJECT_RELPATH="zaps-app/Turnip.xcodeproj"
STUDIO_TF_PBXPROJ="$STUDIO_TF_PROJECT_ROOT/zaps-app/Turnip.xcodeproj/project.pbxproj"
STUDIO_TF_GSIP_PATH="$STUDIO_TF_PROJECT_ROOT/zaps-app/Zaps/Firebase/Prod/GoogleService-Info.plist"
STUDIO_TF_XCPRETTY="$HOME/.gem/ruby/2.6.0/bin/xcpretty"

STUDIO_TF_APP_ID="<app-store-connect-app-id>"
STUDIO_TF_ASC_KEY_ID="<app-store-connect-key-id>"
STUDIO_TF_ASC_ISSUER_ID="<app-store-connect-issuer-id>"
STUDIO_TF_ASC_KEY_PATH="$HOME/.dev-studio/<project>/secrets/appstoreconnect/AuthKey_<app-store-connect-key-id>.p8"

STUDIO_SLACK_TOKEN_FILE="$HOME/.dev-studio/<project>/secrets/slack-bot-token"
