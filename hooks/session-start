#!/usr/bin/env bash
# session-start — host-agnostic session-start hook.
#
# Reads the router-bootstrap primitive and emits it as session-start
# additional context so routing rules, iron laws, and agent roster survive
# startup / clear / compact events. Without this, long sessions can drop
# the root-instructions context after compaction, and the next turn loses
# the invariants.
#
# Host dispatch (env-var → canonical STUDIO_HOST):
#   $CLAUDE_PLUGIN_ROOT set  → STUDIO_HOST=claude-code  (current contract)
#   $CODEX_PLUGIN_ROOT  set  → STUDIO_HOST=codex        (v0.120+; H10 verifies)
#   Neither set              → hook-less host: exit 0 silently. The prose
#                              preamble in achilles/SKILL.md and argus/SKILL.md
#                              is the fallback entry point on those hosts.
#
# Output schemas (stdout JSON):
#   claude-code: {"hookSpecificOutput":{"hookEventName":"SessionStart",
#                                       "additionalContext":"<text>"}}
#   codex:       {"additionalContext":"<text>"}  (subject to H10 verification)
#
# Exit 0 always. Failure modes (missing file, unreadable) emit empty
# context rather than failing the hook — a degraded session beats a
# blocked one.

set -u
umask 022

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  export STUDIO_HOST="claude-code"
elif [ -n "${CODEX_PLUGIN_ROOT:-}" ]; then
  export STUDIO_HOST="codex"
else
  exit 0
fi
SESSION_START_AT=$(date -u +%s)
SESSION_START_BUDGET_S="${STUDIO_SESSION_START_BUDGET_S:-5}"
case "$SESSION_START_BUDGET_S" in
  -[0-9]*|[0-9]*) ;;
  *) SESSION_START_BUDGET_S=5 ;;
esac

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
BOOTSTRAP="$REPO_ROOT/_shared/primitives/router-bootstrap.md"

# Optional: surface any active review-waives for the current project. Best
# effort — failures (no project resolvable, yq missing, no waive dir) all
# collapse to silent skip. The bootstrap prose must still land even if this
# stage errors.
waive_banner() {
  # shellcheck source=../scripts/lib-paths.sh
  . "$REPO_ROOT/scripts/lib-paths.sh" 2>/dev/null || return 0
  local waive_dir f gate started count trigger date_only
  waive_dir=$(resolve_waive_dir 2>/dev/null) || return 0
  [ -d "$waive_dir" ] || return 0
  command -v yq >/dev/null 2>&1 || return 0
  for f in "$waive_dir"/*.yaml; do
    [ -f "$f" ] || continue
    gate=$(yq -r '.gate // ""' "$f" 2>/dev/null)
    started=$(yq -r '.started_at // ""' "$f" 2>/dev/null)
    count=$(yq -r '.accumulated_count // 0' "$f" 2>/dev/null)
    trigger=$(yq -r '.sunset_trigger // ""' "$f" 2>/dev/null)
    [ -z "$gate" ] && gate=$(basename "$f" .yaml)
    date_only="${started%%T*}"
    printf '\n\n*%s paused since %s* - %s tasks merged without review; revisit trigger: %s' \
      "$gate" "${date_only:-unknown}" "${count:-0}" "${trigger:-(not set)}"
  done
}

ctx=""
if [ -f "$BOOTSTRAP" ]; then
  # Strip YAML frontmatter; keep the prose. Prose is what the session needs;
  # the name/description/type keys are linter-relevant only.
  ctx=$(awk '
    BEGIN { in_fm=0; done=0 }
    NR==1 && $0=="---" { in_fm=1; next }
    in_fm==1 && $0=="---" { in_fm=0; done=1; next }
    in_fm==1 { next }
    done==1 { print }
    done==0 && in_fm==0 { print }
  ' "$BOOTSTRAP")
fi

banner=$(waive_banner 2>/dev/null || true)
if [ -n "$banner" ]; then
  ctx="${ctx}${banner}"
fi

# Studio-audit: surface planning-quality drift as part of bootstrap context.
# Silent when clean (sub-second grep probes). On drift, append a one-line
# summary + the findings so the next turn inherits the signal without
# the user having to ask. Failure modes (script missing, grep error) all
# collapse to silent skip — the bootstrap prose must still land.
audit_banner() {
  local audit_script="$REPO_ROOT/scripts/studio-audit.sh"
  [ -x "$audit_script" ] || return 0
  local output exit_code
  output=$("$audit_script" --silent 2>/dev/null || true)
  exit_code=$?
  [ -z "$output" ] && return 0
  printf '\n\n---\n\n**studio-audit (SessionStart):** drift detected — review before acting on plan-level claims.\n\n```\n%s\n```' "$output"
}

audit_out=$(audit_banner 2>/dev/null || true)
if [ -n "$audit_out" ]; then
  ctx="${ctx}${audit_out}"
fi

# Skill-distribution freshness — re-fan-out the symlink farm if any canonical
# skill root has been touched since the last sync. Idempotent and silent in
# the steady state. Background invocation; never blocks the session preamble.
# In long-lived TUI sessions where in-process content caches stale, we surface
# a one-line tip when freshness was actually applied.
skill_freshness_banner() {
  local sync_script="$REPO_ROOT/scripts/sync-host-skills.sh"
  [ -x "$sync_script" ] || return 0
  local stamp_dir="$HOME/.dev-studio/.runtime/state"
  local stamp="$stamp_dir/skill-sync-$STUDIO_HOST.stamp"
  mkdir -p "$stamp_dir" 2>/dev/null || return 0

  # Determine the most recent mtime across canonical skill roots and the
  # registry. If newer than the stamp (or stamp missing), re-sync.
  local newest=0 mtime
  local probe_paths=(
    "$REPO_ROOT/hosts/registry.yaml"
    "$REPO_ROOT/_shared/standards"
  )
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    probe_paths+=("$p")
  done < <(
    cd "$REPO_ROOT" 2>/dev/null && \
    find achilles argus chanakya .claude/skills skills/owned skills/vendored \
         -maxdepth 4 -name 'portability.yaml' -o -name 'SKILL.md' 2>/dev/null \
      | head -200
  )
  local p
  for p in "${probe_paths[@]}"; do
    [ -e "$p" ] || continue
    if mtime=$(stat -f %m "$p" 2>/dev/null); then :;
    elif mtime=$(stat -c %Y "$p" 2>/dev/null); then :;
    else continue
    fi
    [ "$mtime" -gt "$newest" ] && newest="$mtime"
  done

  local stamp_mtime=0
  if [ -f "$stamp" ]; then
    stamp_mtime=$(stat -f %m "$stamp" 2>/dev/null) || stamp_mtime=$(stat -c %Y "$stamp" 2>/dev/null) || stamp_mtime=0
  fi

  [ "$newest" -le "$stamp_mtime" ] && return 0

  # Drift detected — re-sync (silent on success). Run in foreground but bound
  # by a 5s soft cap; if it takes longer, emit nothing rather than block.
  ( "$sync_script" "$STUDIO_HOST" >/dev/null 2>&1 ) &
  local sync_pid=$!
  local i=0
  while [ "$i" -lt 50 ] && kill -0 "$sync_pid" 2>/dev/null; do
    sleep 0.1; i=$((i+1))
  done
  if kill -0 "$sync_pid" 2>/dev/null; then return 0; fi
  if wait "$sync_pid" 2>/dev/null; then
    : > "$stamp" 2>/dev/null || true
    printf '\n\n*Skill farm refreshed (%s): canonical content changed since last sync.*' "$STUDIO_HOST"
  fi
}

skill_out=$(skill_freshness_banner 2>/dev/null || true)
if [ -n "$skill_out" ]; then
  ctx="${ctx}${skill_out}"
fi

# Skill-update PR notifier — surface any open `pr_review_ready` events from
# scripts/update-recipes.sh so a fresh session sees pending recipe bumps in
# its first turn. Best effort; scans the last 7 days of event-log shards.
skill_pr_banner() {
  local events_root="$HOME/.dev-studio/$(basename "$REPO_ROOT")/events"
  [ -d "$events_root" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local cutoff_iso today shard
  if today=$(date -u +%Y-%m-%d 2>/dev/null); then :; else return 0; fi
  # 7-day window — collect up to 7 daily shards.
  local lines i d
  lines=""
  i=0
  while [ "$i" -lt 7 ]; do
    if d=$(date -u -v -"$i"d +%Y-%m-%d 2>/dev/null); then :;
    elif d=$(date -u -d "-$i days" +%Y-%m-%d 2>/dev/null); then :;
    else d=""; fi
    [ -z "$d" ] && { i=$((i+1)); continue; }
    shard="$events_root/$d.jsonl"
    [ -f "$shard" ] || { i=$((i+1)); continue; }
    while IFS= read -r line; do
      lines="$lines$line"$'\n'
    done < <(grep -F '"event":"pr_review_ready"' "$shard" 2>/dev/null || true)
    i=$((i+1))
  done

  [ -z "$lines" ] && return 0

  # Each line carries data.{recipe, pr_url, sha_short, lint}; one banner row per.
  local banner=""
  banner=$(printf '%s' "$lines" | jq -r '
    select(.event == "pr_review_ready")
    | "  • " + (.data.recipe // "?") + " @ " + (.data.sha_short // "?") + "  " + (.data.pr_url // "")
  ' 2>/dev/null)

  [ -z "$banner" ] && return 0

  local count
  count=$(printf '%s\n' "$lines" | grep -c 'pr_review_ready' 2>/dev/null || echo 0)
  printf '\n\n---\n\n📬 **%d skill-update PR(s) awaiting review** (`scripts/update-recipes.sh`):\n\n%s\n\nMerge or close each via `gh pr merge` / `gh pr close`. To stop seeing this banner, acknowledge with: `gh pr list --label skill-bump`.' "$count" "$banner"
}

skill_pr_out=$(skill_pr_banner 2>/dev/null || true)
if [ -n "$skill_pr_out" ]; then
  ctx="${ctx}${skill_pr_out}"
fi

# Track-work auto-start: if STUDIO_TRACK is set, claim the next issue and
# inject a work directive so Claude starts immediately without user input.
track_banner() {
  [ -n "${STUDIO_TRACK:-}" ] || return 0
  local track_script="$REPO_ROOT/scripts/track-next.sh"
  [ -x "$track_script" ] || return 0
  local output
  output=$("$track_script" "$STUDIO_TRACK" 2>/dev/null) || {
    # exit 1 = track complete; exit 2 = bad args — both surface cleanly
    printf '\n\nSTUDIO_TRACK=%s is set but track-next.sh exited non-zero. Check branch exists and gh auth is valid.' "$STUDIO_TRACK"
    return 0
  }
  printf '\n\n---\n\n**Auto-work mode (STUDIO_TRACK=%s):** Issue claimed — implement it now, commit to the track branch, close the issue, then call `scripts/track-next.sh %s` to claim the next one.\n\n```\n%s\n```' \
    "$STUDIO_TRACK" "$STUDIO_TRACK" "$output"
}

track_out=$(track_banner 2>/dev/null || true)
if [ -n "$track_out" ]; then
  ctx="${ctx}${track_out}"
fi

SESSION_START_DURATION_S=$(( $(date -u +%s) - SESSION_START_AT ))
SESSION_START_STATUS="completed"
if [ "$SESSION_START_DURATION_S" -gt "$SESSION_START_BUDGET_S" ]; then
  SESSION_START_STATUS="budget_exceeded"
  ctx="${ctx}"$'\n\n'"*SessionStart latency warning: ${SESSION_START_DURATION_S}s exceeded ${SESSION_START_BUDGET_S}s budget.*"
fi

emit_session_start_timing() {
  # shellcheck source=../scripts/lib-ledger.sh
  . "$REPO_ROOT/scripts/lib-ledger.sh" 2>/dev/null || return 0
  local data
  data=$(printf '{"host":"%s","status":"%s","duration_s":%s,"budget_s":%s}' \
    "$(_json_escape "$STUDIO_HOST")" \
    "$(_json_escape "$SESSION_START_STATUS")" \
    "$SESSION_START_DURATION_S" \
    "$SESSION_START_BUDGET_S")
  emit_event_keyed studio session-start session_start_completed "" "$data" \
    --idem-key "session-start:$STUDIO_HOST:$SESSION_START_AT" >/dev/null 2>&1 || true
}
emit_session_start_timing

# JSON-escape the context (quotes, backslashes, newlines, tabs).
json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//	/\\t}
  s=${s//$'\r'/}
  # Replace actual newlines with literal \n for JSON.
  s=$(printf '%s' "$s" | awk 'BEGIN { ORS="" } { if (NR>1) printf "\\n"; printf "%s", $0 }')
  printf '%s' "$s"
}

escaped=$(json_escape "$ctx")

case "$STUDIO_HOST" in
  claude-code)
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped"
    ;;
  codex)
    printf '{"additionalContext":"%s"}\n' "$escaped"
    ;;
esac
